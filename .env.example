EXAMPLE_SECRET=👀 What you looking at?
EXAMPLE_CONFIG=https://twitter.com/zuplo

# Auth0 tenant used for the MCP Gateway's inbound OAuth (browser login)
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Bearer token the gateway sends to the demo MCP upstream
DEMO_MCP_TOKEN=

# Identifier of the Auth0 API this project's own inbound MCP-server-delegated
# route requires callers' tokens to be minted for (Applications > APIs).
# Reuses the mcp-gateway-token-exchange project's echo-mcp-server API --
# a deliberate choice for this demo (not a production pattern): reusing an
# audience across projects means a token minted for one is technically also
# valid at the other, which is the exact "audience confusion" RFC 8707
# exists to prevent. Fine here since both are our own demo resources in the
# same tenant; a real deployment should give each route its own audience.
AUTH0_INBOUND_AUDIENCE=https://echo-mcp-server

# Identifier of the Auth0 API representing the downstream service the token
# exchange mints a new token for. Reuses the same echo.zuplo.io API the
# other project's M2M hop already uses -- this one's a clean reuse, since
# it's genuinely the same real downstream resource in both cases.
AUTH0_DOWNSTREAM_AUDIENCE=https://echo.zuplo.io/

# Keycloak (self-hosted via Docker + a cloudflared quick tunnel) used by
# /mcp-server-delegated for real per-user RFC 8693 token exchange, in place
# of Auth0's Custom Token Exchange -- which requires a paid Auth0 plan this
# tenant doesn't have. Ephemeral: the trycloudflare.com hostname changes
# whenever the tunnel or container restarts, so these need updating then.
KEYCLOAK_ISSUER=http://<tunnel-host>/realms/mcp-demo
KEYCLOAK_JWKS_URL=https://<tunnel-host>/realms/mcp-demo/protocol/openid-connect/certs
KEYCLOAK_INBOUND_AUDIENCE=gateway-inbound-client
KEYCLOAK_TOKEN_URL=https://<tunnel-host>/realms/mcp-demo/protocol/openid-connect/token
KEYCLOAK_DOWNSTREAM_AUDIENCE=downstream-api
KEYCLOAK_CLIENT_ID=gateway-inbound-client
KEYCLOAK_CLIENT_SECRET=