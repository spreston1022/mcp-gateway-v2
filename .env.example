EXAMPLE_SECRET=👀 What you looking at?
EXAMPLE_CONFIG=https://twitter.com/zuplo

# Auth0 tenant used for the MCP Gateway's inbound OAuth (browser login)
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Bearer token the gateway sends to the demo MCP upstream
DEMO_MCP_TOKEN=

# Identifier of the Auth0 API this project's own inbound MCP-server-delegated
# route requires callers' tokens to be minted for (Applications > APIs).
AUTH0_INBOUND_AUDIENCE=https://your-tenant.example/mcp-inbound

# Identifier of the Auth0 API representing the downstream service the token
# exchange mints a new token for (Applications > APIs).
AUTH0_DOWNSTREAM_AUDIENCE=https://your-tenant.example/downstream